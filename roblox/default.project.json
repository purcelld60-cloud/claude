{
  "name": "Da Roça Adventure",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "DaRoca": {
        "$className": "Folder",
        "runtime": { "$path": "src/runtime" },
        "jogo": { "$path": "src/jogo" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "DaRocaServidor": { "$path": "src/servidor/DaRoca.server.lua" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "DevTouchMovementMode": "Scriptable",
        "DevComputerMovementMode": "Scriptable"
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "DaRocaCliente": { "$path": "src/cliente/DaRoca.client.lua" }
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": { "CharacterAutoLoads": false }
    }
  }
}

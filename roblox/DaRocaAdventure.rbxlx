]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000002"><Properties><string name="Name">Combate</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- Da Roça Adventure (protótipo para Roblox)
-- Combate: soco dos jogadores, valentões que patrulham a estrada e a praça, e o chefe
-- Igor na escola, com o pulo de barriga (prepara os braços, solta no ar, pousa
-- amortecendo) e a onda de choque em blocos.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local remotes = ReplicatedStorage:WaitForChild("DaRocaRemotes")
local Ataque = remotes:WaitForChild("Ataque")
local Efeito = remotes:WaitForChild("Efeito")
local mapa = workspace:WaitForChild("DaRocaMapa")
while not mapa:GetAttribute("Pronto") do
	task.wait(0.1)
end

local pasta = Instance.new("Folder")
pasta.Name = "DaRocaInimigos"
pasta.Parent = workspace

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local function parte(model, nome, tamanho, cor, material, forma)
	local p = Instance.new("Part")
	p.Name = nome
	p.Size = tamanho
	p.Color = cor
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if forma == "elipse" then
		-- bloco com malha de esfera: aceita tamanhos diferentes em cada eixo (amassar/esticar)
		local malha = Instance.new("SpecialMesh")
		malha.MeshType = Enum.MeshType.Sphere
		malha.Parent = p
	elseif forma then
		p.Shape = forma
	end
	p.Parent = model
	return p
end
local function sinal(v)
	if v < 0 then
		return -1
	end
	return 1
end

-- Lista do que pode levar soco: cada alvo diz onde está e o que fazer ao ser atingido
local alvos = {}

-- Jogador vivo mais próximo de x (opcionalmente dentro de um intervalo)
local function jogadorPerto(x, alcance, xmin, xmax)
	local melhor, melhorPl, melhorD = nil, nil, alcance
	for _, pl in ipairs(Players:GetPlayers()) do
		local ch = pl.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			local px = hrp.Position.X
			local d = math.abs(px - x)
			if d < melhorD and (not xmin or (px >= xmin and px <= xmax)) then
				melhor, melhorPl, melhorD = hrp, pl, d
			end
		end
	end
	return melhor, melhorPl
end

local function machucar(pl, dano, empurraX, empurraY)
	local ch = pl.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return
	end
	if ch:GetAttribute("Invulneravel") then
		return
	end
	hum:TakeDamage(dano)
	ch:SetAttribute("Invulneravel", true)
	task.delay(0.8, function()
		if ch.Parent then
			ch:SetAttribute("Invulneravel", nil)
		end
	end)
	Efeito:FireClient(pl, "empurrao", empurraX, empurraY)
end

-- Estilhaços de blocos quando alguém é derrotado
local function estilhacar(pos, cores, n)
	for i = 1, n do
		local p = Instance.new("Part")
		p.Size = Vector3.new(0.6, 0.6, 0.6)
		p.Color = cores[(i % #cores) + 1]
		p.Material = Enum.Material.SmoothPlastic
		p.Position = pos + Vector3.new(math.random() - 0.5, math.random() * 2, 0)
		p.CanTouch = false
		p.CanQuery = false
		p.Parent = workspace
		p.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 40, 20 + math.random() * 25, 0)
		Debris:AddItem(p, 1.6)
	end
end

------------------------------------------------------------------------------------
-- Valentões
------------------------------------------------------------------------------------
local valentoes = {}
local CAMISAS = { rgb(200, 56, 56), rgb(60, 60, 70), rgb(220, 140, 40), rgb(70, 110, 60) }

local function criarValentao(x, xmin, xmax, i)
	local m = Instance.new("Model")
	m.Name = "Valentao"
	local pele = rgb(206, 150, 112)
	local camisa = CAMISAS[(i % #CAMISAS) + 1]
	local e = {
		model = m, x = x, x0 = x, xmin = xmin, xmax = xmax, dir = -1, hp = 3, vivo = true,
		empurrao = 0, ultimoGolpe = 0, flash = 0, soco = 0, p = {},
	}
	e.p.pernaE = parte(m, "PernaE", Vector3.new(0.9, 2, 0.9), rgb(50, 60, 90), Enum.Material.Fabric)
	e.p.pernaD = parte(m, "PernaD", Vector3.new(0.9, 2, 0.9), rgb(50, 60, 90), Enum.Material.Fabric)
	e.p.tronco = parte(m, "Tronco", Vector3.new(2, 2.2, 1.1), camisa, Enum.Material.Fabric)
	e.p.bracoE = parte(m, "BracoE", Vector3.new(0.8, 2, 0.8), pele)
	e.p.bracoD = parte(m, "BracoD", Vector3.new(0.8, 2, 0.8), pele)
	e.p.cabeca = parte(m, "Cabeca", Vector3.new(1.3, 1.3, 1.3), pele)
	e.p.bone = parte(m, "Bone", Vector3.new(1.4, 0.4, 1.4), camisa)
	e.p.aba = parte(m, "Aba", Vector3.new(1.2, 0.15, 0.8), camisa)
	e.p.olhoE = parte(m, "OlhoE", Vector3.new(0.2, 0.25, 0.1), rgb(20, 20, 24))
	e.p.olhoD = parte(m, "OlhoD", Vector3.new(0.2, 0.25, 0.1), rgb(20, 20, 24))
	e.p.sobr = parte(m, "Sobrancelha", Vector3.new(0.9, 0.12, 0.1), rgb(40, 30, 24))
	e.cores = {}
	for k, p in pairs(e.p) do
		e.cores[k] = p.Color
	end
	m.Parent = pasta
	table.insert(valentoes, e)
	table.insert(alvos, {
		pos = function()
			if e.vivo then
				return Vector3.new(e.x, 3, 0), 0.6
			end
		end,
		hit = function(dano, dir)
			e.hp = e.hp - dano
			e.flash = 0.1
			e.empurrao = dir * 22
			Efeito:FireAllClients("acerto", Vector3.new(e.x, 3.2, 0), dir, camisa)
			if e.hp <= 0 then
				e.vivo = false
				estilhacar(Vector3.new(e.x, 2.5, 0), { camisa, pele, rgb(50, 60, 90) }, 14)
				for _, p in pairs(e.p) do
					p.Transparency = 1
				end
				task.delay(25, function()
					e.x, e.hp, e.vivo = e.x0, 3, true
					for _, p in pairs(e.p) do
						p.Transparency = 0
					end
				end)
			end
		end,
	})
	return e
end

local function poseValentao(e, t, andando)
	local giro = e.dir > 0 and -math.pi / 2 or math.pi / 2
	local base = CFrame.new(e.x, 0, 0) * CFrame.Angles(0, giro, 0) -- frente = -Z local
	local s = andando and math.sin(t * 11) * 0.7 or 0
	local respira = math.sin(t * 2.5) * 0.05
	local p = e.p
	p.pernaE.CFrame = base * CFrame.new(-0.5, 2.1, 0) * CFrame.Angles(s, 0, 0) * CFrame.new(0, -1, 0)
	p.pernaD.CFrame = base * CFrame.new(0.5, 2.1, 0) * CFrame.Angles(-s, 0, 0) * CFrame.new(0, -1, 0)
	p.tronco.CFrame = base * CFrame.new(0, 3.2 + respira, 0)
	local socoAng = 0
	if e.soco > 0 then
		socoAng = math.rad(100) * math.sin((e.soco / 0.3) * math.pi)
	end
	p.bracoE.CFrame = base * CFrame.new(-1.4, 4.1, 0) * CFrame.Angles(-s * 0.8, 0, 0) * CFrame.new(0, -0.9, 0)
	p.bracoD.CFrame = base * CFrame.new(1.4, 4.1, 0) * CFrame.Angles(s * 0.8 + socoAng, 0, 0) * CFrame.new(0, -0.9, 0)
	local cab = base * CFrame.new(0, 4.95 + respira, 0)
	p.cabeca.CFrame = cab
	p.bone.CFrame = cab * CFrame.new(0, 0.75, 0)
	p.aba.CFrame = cab * CFrame.new(0, 0.6, -0.9)
	p.olhoE.CFrame = cab * CFrame.new(-0.3, 0.05, -0.66)
	p.olhoD.CFrame = cab * CFrame.new(0.3, 0.05, -0.66)
	p.sobr.CFrame = cab * CFrame.new(0, 0.3, -0.66) * CFrame.Angles(0, 0, 0.12)
	local branco = e.flash > 0
	for k, part in pairs(p) do
		part.Color = branco and Color3.new(1, 1, 1) or e.cores[k]
	end
end

local POS_VALENTOES = {
	{ 150, 110, 240 },
	{ 400, 340, 455 },
	{ 525, 470, 555 },
	{ 615, 570, 710 },
	{ 680, 640, 712 },
}
for i, v in ipairs(POS_VALENTOES) do
	criarValentao(v[1], v[2], v[3], i)
end

local function atualizarValentoes(dt, t)
	for _, e in ipairs(valentoes) do
		if e.vivo then
			e.flash = math.max(0, e.flash - dt)
			e.soco = math.max(0, e.soco - dt)
			local alvo, pl = jogadorPerto(e.x, 26, e.xmin - 6, e.xmax + 6)
			local andando = false
			if math.abs(e.empurrao) > 0.5 then
				e.x = e.x + e.empurrao * dt
				e.empurrao = e.empurrao * math.exp(-dt * 8)
			elseif alvo and math.abs(alvo.Position.Y - 3) < 7 then
				local dx = alvo.Position.X - e.x
				e.dir = sinal(dx)
				if math.abs(dx) > 2 then
					e.x = e.x + e.dir * 8.5 * dt
					andando = true
				end
				if math.abs(dx) < 3 and math.abs(alvo.Position.Y - 3) < 3.5 and t - e.ultimoGolpe > 1.1 then
					e.ultimoGolpe = t
					e.soco = 0.3
					machucar(pl, 12, e.dir * 45, 30)
				end
			else
				e.x = e.x + e.dir * 4 * dt
				andando = true
				if e.x > e.xmax then
					e.dir = -1
				elseif e.x < e.xmin then
					e.dir = 1
				end
			end
			e.x = math.clamp(e.x, e.xmin, e.xmax)
			poseValentao(e, t, andando)
		end
	end
end

------------------------------------------------------------------------------------
-- IGOR, o monitor da escola
------------------------------------------------------------------------------------
local ARENA_MIN, ARENA_MAX, IGOR_CASA = 742, 888, 850
local IGOR_VIDA = 30
local K = 0.15 -- 1 pixel do desenho original = 0.15 stud
local PELE, PELE2 = rgb(231, 160, 121), rgb(239, 178, 139)
local CAMISA, CALCA, TENIS = rgb(124, 128, 117), rgb(35, 58, 88), rgb(237, 240, 221)
local BARBA, SOBR = rgb(101, 76, 62), rgb(114, 80, 62)

local igorModel = Instance.new("Model")
igorModel.Name = "Igor"
local I = {}
I.pernaE = parte(igorModel, "PernaE", Vector3.new(2.1, 3.2, 2), CALCA, Enum.Material.Fabric)
I.pernaD = parte(igorModel, "PernaD", Vector3.new(2.1, 3.2, 2), CALCA, Enum.Material.Fabric)
I.tenisE = parte(igorModel, "TenisE", Vector3.new(3, 1.2, 2.4), TENIS)
I.tenisD = parte(igorModel, "TenisD", Vector3.new(3, 1.2, 2.4), TENIS)
I.corpo = parte(igorModel, "Corpo", Vector3.new(9, 9, 9), CAMISA, Enum.Material.Fabric, "elipse")
I.barriga = parte(igorModel, "Barriga", Vector3.new(7.2, 6.9, 6), PELE, nil, "elipse")
I.barriga2 = parte(igorModel, "Barriga2", Vector3.new(5.4, 5.2, 4.8), PELE2, nil, "elipse")
I.umbigo = parte(igorModel, "Umbigo", Vector3.new(0.7, 0.6, 0.3), rgb(188, 123, 93))
I.cabeca = parte(igorModel, "Cabeca", Vector3.new(5.2, 4.6, 4.6), PELE, nil, "elipse")
I.barba = parte(igorModel, "Barba", Vector3.new(2.9, 0.8, 0.6), BARBA)
I.barba2 = parte(igorModel, "Barba2", Vector3.new(1.8, 0.6, 0.6), BARBA)
I.olhoE = parte(igorModel, "OlhoE", Vector3.new(0.45, 0.6, 0.3), rgb(48, 53, 59))
I.olhoD = parte(igorModel, "OlhoD", Vector3.new(0.45, 0.6, 0.3), rgb(48, 53, 59))
I.sobrE = parte(igorModel, "SobrE", Vector3.new(1.05, 0.3, 0.3), SOBR)
I.sobrD = parte(igorModel, "SobrD", Vector3.new(1.05, 0.3, 0.3), SOBR)
I.nariz = parte(igorModel, "Nariz", Vector3.new(1, 0.6, 0.5), rgb(193, 132, 98))
I.bracoE1 = parte(igorModel, "BracoE1", Vector3.new(1.3, 1.3, 2), PELE)
I.bracoE2 = parte(igorModel, "BracoE2", Vector3.new(1.2, 1.2, 2), PELE)
I.bracoD1 = parte(igorModel, "BracoD1", Vector3.new(1.3, 1.3, 2), PELE)
I.bracoD2 = parte(igorModel, "BracoD2", Vector3.new(1.2, 1.2, 2), PELE)
I.maoE = parte(igorModel, "MaoE", Vector3.new(1.3, 1.3, 1.3), PELE2)
I.maoD = parte(igorModel, "MaoD", Vector3.new(1.3, 1.3, 1.3), PELE2)
local IGOR_CORES = {}
for k, p in pairs(I) do
	IGOR_CORES[k] = p.Color
	p.CastShadow = true
end
-- sombra de pouso em pixels e setas piscando
local marca = {}
for i = -3, 3 do
	local w = 1.6
	local h = 0.12
	local q = parte(igorModel, "Sombra", Vector3.new(w, h, (4 - math.abs(i)) * 0.9 + 0.4), rgb(20, 16, 24))
	q.Transparency = 1
	marca[#marca + 1] = { part = q, i = i }
end
local setaE = parte(igorModel, "Seta", Vector3.new(0.8, 0.8, 0.2), rgb(255, 70, 60), Enum.Material.Neon)
local setaD = parte(igorModel, "Seta", Vector3.new(0.8, 0.8, 0.2), rgb(255, 70, 60), Enum.Material.Neon)
setaE.Transparency, setaD.Transparency = 1, 1
-- estrelinhas de cansaço
local estrelas = {}
for i = 1, 3 do
	local s = parte(igorModel, "Estrela", Vector3.new(0.7, 0.7, 0.2), rgb(255, 230, 90), Enum.Material.Neon)
	s.Transparency = 1
	estrelas[i] = s
end
igorModel:SetAttribute("HP", IGOR_VIDA)
igorModel:SetAttribute("MaxHP", IGOR_VIDA)
igorModel:SetAttribute("Ativo", false)
igorModel.Parent = pasta

local B = {
	x = IGOR_CASA, y = 0, dir = -1, hp = IGOR_VIDA, estado = "espera", t = 0, ciclo = 0,
	flash = 0, tx = IGOR_CASA, x0 = IGOR_CASA, segundo = false, rolarDir = 1, rolarAng = 0,
	ultimoContato = 0,
}
local function mudar(estado)
	B.estado = estado
	B.t = 0
end
local function fase2()
	return B.hp <= IGOR_VIDA / 2
end

-- Converte um ponto do desenho 2D (x para a direita, y negativo para cima) em mundo
local function P(px, py, ys, z)
	return Vector3.new(B.x + px * K * B.dir, B.y - py * K * ys, z or 0)
end
local function membro(part, a, b)
	local d = (b - a).Magnitude
	part.Size = Vector3.new(part.Size.X, part.Size.Y, d + 0.5)
	part.CFrame = CFrame.lookAt((a + b) / 2, b)
end

-- Poses de braço iguais às da campanha (preparar, subir, cair, pousar)
local function bracos(pose, k, andar)
	local AL = { { -25, -57 }, { -33, -38 + andar }, { -29, -28 + andar } }
	local AR = { { 25, -58 }, { 34, -39 - andar }, { 29, -26 - andar } }
	if pose == "preparar" then
		AL = { { -25, -57 }, { -38, -46 + k * 4 }, { -46, -34 + k * 8 } }
		AR = { { 25, -58 }, { 16, -44 + k * 2 }, { 4, -32 + k * 6 } }
	elseif pose == "subir" then
		AL = { { -25, -57 }, { -33, -77 }, { -27, -97 } }
		AR = { { 25, -58 }, { 33, -79 }, { 27, -99 } }
	elseif pose == "cair" then
		AL = { { -25, -57 }, { -46, -63 }, { -61, -58 } }
		AR = { { 25, -58 }, { 46, -64 }, { 61, -59 } }
	elseif pose == "pousar" then
		AL = { { -25, -57 }, { -44, -46 }, { -54, -36 } }
		AR = { { 25, -58 }, { 44, -47 }, { 54, -37 } }
	elseif pose == "derrota" then
		AL = { { -25, -57 }, { -40, -50 }, { -50, -44 } }
		AR = { { 25, -58 }, { 40, -51 }, { 50, -45 } }
	end
	return AL, AR
end

local function poseIgor(t, pose, k, ys, andando)
	local andar = andando and math.sin(t * 7) * 4 or 0
	local tremor = 0
	if pose == "preparar" then
		tremor = math.sin(t * 60) * 0.12 * k
	end
	local x0 = B.x
	B.x = B.x + tremor
	-- pernas e tênis
	local lx, rx, ly, sy = -11 + andar, 12 - andar, -12.5, -4
	if pose == "subir" then
		lx, rx, ly, sy = -10, 11, -21, -11
	elseif pose == "preparar" then
		local sp = k * 5
		lx, rx = -13 - sp, 14 + sp
	end
	I.pernaE.CFrame = CFrame.new(P(lx, ly, ys))
	I.pernaD.CFrame = CFrame.new(P(rx, ly, ys))
	I.tenisE.CFrame = CFrame.new(P(lx, sy, ys, 0.4))
	I.tenisD.CFrame = CFrame.new(P(rx, sy, ys, 0.4))
	-- corpo, barriga de fora e umbigo
	local respira = 1 + math.sin(t * 2.4) * 0.015
	I.corpo.CFrame = CFrame.new(P(0, -40, ys))
	I.corpo.Size = Vector3.new(9 * respira, 9 * ys, 9)
	I.barriga.CFrame = CFrame.new(P(5, -38, ys, 1.6))
	I.barriga2.CFrame = CFrame.new(P(8, -39, ys, 2.3))
	I.umbigo.CFrame = CFrame.new(P(8.5, -37, ys, 4.6))
	-- cabeça
	local cab = P(-1, -75, ys)
	I.cabeca.CFrame = CFrame.new(cab)
	local face = function(px, py, z)
		return CFrame.new(P(px, py, ys, z))
	end
	I.olhoE.CFrame = face(-8.5, -72, 2.1)
	I.olhoD.CFrame = face(6.5, -72, 2.1)
	local raiva = fase2() and 0.25 or 0
	I.sobrE.CFrame = face(-8.5, -77, 2.05) * CFrame.Angles(0, 0, -raiva * B.dir)
	I.sobrD.CFrame = face(7.5, -77, 2.05) * CFrame.Angles(0, 0, raiva * B.dir)
	I.nariz.CFrame = face(-0.5, -69, 2.3)
	I.barba.CFrame = face(-0.5, -61.5, 1.9)
	I.barba2.CFrame = face(0, -58.5, 1.7)
	-- braços
	local AL, AR = bracos(pose, k, andar)
	local function braco(pts, p1, p2, mao)
		local a = P(pts[1][1], pts[1][2], ys, 0.5)
		local b = P(pts[2][1], pts[2][2], ys, 0.8)
		local c = P(pts[3][1], pts[3][2], ys, 0.9)
		membro(p1, a, b)
		membro(p2, b, c)
		mao.CFrame = CFrame.new(c)
	end
	braco(AL, I.bracoE1, I.bracoE2, I.maoE)
	braco(AR, I.bracoD1, I.bracoD2, I.maoD)
	B.x = x0
	-- piscar branco ao levar soco
	local branco = B.flash > 0
	for nome, p in pairs(I) do
		p.Color = branco and Color3.new(1, 1, 1) or IGOR_CORES[nome]
	end
end

local function mostrarCorpo(visivel)
	for _, p in pairs(I) do
		p.Transparency = visivel and 0 or 1
	end
end

local function mostrarMarca(x, k, piscar)
	for _, q in ipairs(marca) do
		if x then
			q.part.Transparency = 0.25 + (1 - k) * 0.6
			q.part.CFrame = CFrame.new(x + q.i * 1.6 * (0.5 + k * 0.5), 0.07, 0)
		else
			q.part.Transparency = 1
		end
	end
	local vis = x and piscar
	setaE.Transparency = vis and 0 or 1
	setaD.Transparency = vis and 0 or 1
	if x then
		local s = 7 + (1 - k) * 4
		setaE.CFrame = CFrame.new(x - s, 1.2, 0.5) * CFrame.Angles(0, 0, math.rad(45))
		setaD.CFrame = CFrame.new(x + s, 1.2, 0.5) * CFrame.Angles(0, 0, math.rad(45))
	end
end

local function mostrarEstrelas(t, vis)
	for i, s in ipairs(estrelas) do
		if vis then
			local a = t * 4 + i * 2.1
			s.Transparency = 0
			s.CFrame = CFrame.new(B.x + math.cos(a) * 2.6, B.y + 15 + math.sin(a * 2) * 0.3, math.sin(a) * 1.5) * CFrame.Angles(0, 0, a)
		else
			s.Transparency = 1
		end
	end
end

local function jogadorNaArena()
	return jogadorPerto(B.x, 400, ARENA_MIN - 8, ARENA_MAX + 8)
end

local function impacto()
	Efeito:FireAllClients("impacto", Vector3.new(B.x, 0, 0), fase2())
	for _, pl in ipairs(Players:GetPlayers()) do
		local ch = pl.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp then
			local dx = hrp.Position.X - B.x
			if math.abs(dx) < 11 and hrp.Position.Y < 5.5 then
				machucar(pl, 22, sinal(dx) * 60, 40)
			end
		end
	end
end

local function reiniciarIgor()
	B.x, B.y, B.hp, B.ciclo, B.segundo = IGOR_CASA, 0, IGOR_VIDA, 0, false
	igorModel:SetAttribute("HP", B.hp)
	igorModel:SetAttribute("Ativo", false)
	mostrarCorpo(true)
	mudar("espera")
end

table.insert(alvos, {
	pos = function()
		if B.estado == "espera" or B.estado == "intro" or B.estado == "derrota" then
			return nil
		end
		if B.estado == "rolar" then
			return Vector3.new(B.x, 4.5, 0), 3.5
		end
		return Vector3.new(B.x, B.y + 6.5, 0), 3.8
	end,
	hit = function(dano, dir)
		B.hp = math.max(0, B.hp - dano)
		B.flash = 0.09
		igorModel:SetAttribute("HP", B.hp)
		Efeito:FireAllClients("acerto", Vector3.new(B.x - dir * 3, B.y + 7, 0), dir, CAMISA)
		if B.hp <= 0 then
			mudar("derrota")
			Efeito:FireAllClients("vitoria")
		end
	end,
})

local function atualizarIgor(dt, t)
	B.t = B.t + dt
	B.flash = math.max(0, B.flash - dt)
	local alvo = jogadorNaArena()
	local est = B.estado
	local pose, k, ys, andando = nil, 1, 1, false
	local p2 = fase2()
	mostrarMarca(nil)
	mostrarEstrelas(t, false)

	if est ~= "espera" and est ~= "derrota" and not alvo then
		reiniciarIgor() -- todo mundo saiu ou caiu: o Igor volta inteiro
		est = B.estado
	end

	if est == "espera" then
		B.dir = -1
		if alvo then
			igorModel:SetAttribute("Ativo", true)
			Efeito:FireAllClients("banner", "IGOR", "o monitor da escola")
			mudar("intro")
		end
	elseif est == "intro" then
		pose = B.t < 1 and "preparar" or nil
		k = math.min(1, B.t * 2)
		if B.t > 2 then
			mudar("andar")
		end
	elseif est == "andar" then
		local dx = alvo.Position.X - B.x
		B.dir = sinal(dx)
		if math.abs(dx) > 4 then
			B.x = B.x + B.dir * (p2 and 7 or 5) * dt
			andando = true
		end
		if B.t > (p2 and 1 or 1.4) then
			B.tx = math.clamp(alvo.Position.X, ARENA_MIN, ARENA_MAX)
			if p2 and B.ciclo % 3 == 2 then
				mudar("rolarPrep")
			else
				mudar("preparar")
			end
		end
	elseif est == "preparar" then
		-- agacha e joga os braços para trás pegando impulso
		local dur = p2 and 0.55 or 0.8
		pose, k = "preparar", math.min(1, B.t / dur)
		ys = 1 - 0.12 * k
		B.dir = sinal(B.tx - B.x)
		mostrarMarca(B.tx, 0.2, math.floor(t * 8) % 2 == 0)
		if B.t > dur then
			B.x0 = B.x
			mudar("ar")
		end
	elseif est == "ar" then
		-- solta os braços para cima na subida, abre para equilibrar na descida
		local dur = 1.05
		local u = math.min(1, B.t / dur)
		B.x = B.x0 + (B.tx - B.x0) * u
		B.y = 4 * 16 * u * (1 - u)
		if u < 0.45 then
			pose, ys = "subir", 1.1
		elseif u < 0.8 then
			pose, ys = "cair", 1.05
		else
			pose, ys = "pousar", 1
		end
		mostrarMarca(B.tx, u, math.floor(t * 10) % 2 == 0)
		if u >= 1 then
			B.y = 0
			impacto()
			mudar("pouso")
		end
	elseif est == "pouso" then
		-- braços baixos amortecendo; o corpo amassa e volta
		pose = "pousar"
		local u = math.min(1, B.t / 0.45)
		ys = 0.84 + 0.16 * u + math.sin(u * math.pi * 3) * 0.04 * (1 - u)
		if B.t > 0.45 then
			if p2 and not B.segundo then
				B.segundo = true
				B.tx = math.clamp(alvo.Position.X, ARENA_MIN, ARENA_MAX)
				mudar("preparar")
			else
				B.segundo = false
				mudar("cansado")
			end
		end
	elseif est == "cansado" then
		ys = 1 - math.abs(math.sin(B.t * 3)) * 0.04
		mostrarEstrelas(t, true)
		if B.t > (p2 and 0.8 or 1.2) then
			B.ciclo = B.ciclo + 1
			mudar("andar")
		end
	elseif est == "rolarPrep" then
		pose, k = "preparar", math.min(1, B.t / 0.6)
		ys = 1 - 0.15 * k
		if B.t > 0.6 then
			B.rolarDir = sinal(alvo.Position.X - B.x)
			mudar("rolar")
		end
	elseif est == "rolar" then
		-- vira uma bola de barriga e atravessa o pátio: pule duas vezes por cima!
		B.x = B.x + B.rolarDir * 30 * dt
		B.rolarAng = B.rolarAng - B.rolarDir * dt * 30 / 4.5
		for _, pl in ipairs(Players:GetPlayers()) do
			local ch = pl.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
			if hrp and math.abs(hrp.Position.X - B.x) < 5 and hrp.Position.Y < 9 then
				machucar(pl, 20, B.rolarDir * 55, 35)
			end
		end
		if (B.rolarDir > 0 and B.x >= ARENA_MAX) or (B.rolarDir < 0 and B.x <= ARENA_MIN) or B.t > 3 then
			B.x = math.clamp(B.x, ARENA_MIN, ARENA_MAX)
			Efeito:FireAllClients("impacto", Vector3.new(B.x, 0, 0), false)
			mudar("cansado")
		end
	elseif est == "derrota" then
		pose = "derrota"
		ys = math.max(0.5, 1 - B.t * 0.5)
		if B.t > 1 and not B.estilhacado then
			B.estilhacado = true
			estilhacar(Vector3.new(B.x, 6, 0), { CAMISA, PELE, CALCA, TENIS }, 30)
			mostrarCorpo(false)
		end
		if B.t > 15 then
			B.estilhacado = false
			reiniciarIgor()
		end
	end

	B.x = math.clamp(B.x, ARENA_MIN, ARENA_MAX)
	if B.estado == "rolar" then
		-- bola: barriga gira, o resto some
		for nome, p in pairs(I) do
			p.Transparency = (nome == "corpo" or nome == "barriga" or nome == "cabeca") and 0 or 1
		end
		local centro = CFrame.new(B.x, 4.6, 0) * CFrame.Angles(0, 0, B.rolarAng)
		I.corpo.Size = Vector3.new(9, 9, 9)
		I.corpo.CFrame = centro
		I.barriga.CFrame = centro * CFrame.new(1.2, 0, 1.6)
		I.cabeca.CFrame = centro * CFrame.new(-1.5, 2.6, 2.2)
	elseif not B.estilhacado then
		if B.estado ~= "derrota" then
			mostrarCorpo(true)
		end
		poseIgor(t, pose, k, ys, andando)
	end
	-- encostar no Igor andando também machuca um pouco
	if (B.estado == "andar" or B.estado == "cansado") and alvo and t - B.ultimoContato > 1 then
		if math.abs(alvo.Position.X - B.x) < 4 and alvo.Position.Y < 9 then
			B.ultimoContato = t
			local pl = Players:GetPlayerFromCharacter(alvo.Parent)
			if pl then
				machucar(pl, 8, sinal(alvo.Position.X - B.x) * 45, 30)
			end
		end
	end
end

------------------------------------------------------------------------------------
-- Soco dos jogadores
------------------------------------------------------------------------------------
local ultimoSoco = {}
Ataque.OnServerEvent:Connect(function(pl, dir)
	local agora = os.clock()
	if ultimoSoco[pl] and agora - ultimoSoco[pl] < 0.25 then
		return
	end
	ultimoSoco[pl] = agora
	local ch = pl.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return
	end
	dir = (type(dir) == "number" and dir < 0) and -1 or 1
	local pos = hrp.Position
	Efeito:FireAllClients("golpe", pl.UserId, pos, dir)
	for _, a in ipairs(alvos) do
		local ap, raio = a.pos()
		if ap then
			local dx = (ap.X - pos.X) * dir
			local dy = math.abs(ap.Y - pos.Y)
			if dx > -1.5 and dx < 5.5 + raio and dy < 3.5 + raio then
				a.hit(1, dir)
			end
		end
	end
end)
Players.PlayerRemoving:Connect(function(pl)
	ultimoSoco[pl] = nil
end)

local relogio = 0
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.1)
	relogio = relogio + dt
	atualizarValentoes(dt, relogio)
	atualizarIgor(dt, relogio)
end)
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX00000006"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000005"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000004"><Properties><string name="Name">Cliente</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- Da Roça Adventure (protótipo para Roblox)
-- Lado do jogador: câmera lateral como no jogo 2D, pista travada, pulo duplo, soco com
-- rastro, efeitos (faíscas, poeira, onda de blocos, tremor), aves que fogem, torcida,
-- vento nas folhas, balsa do rio, barra de vida do chefe e avisos na tela.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local jogador = Players.LocalPlayer
local camera = workspace.CurrentCamera
local remotes = ReplicatedStorage:WaitForChild("DaRocaRemotes")
local Ataque = remotes:WaitForChild("Ataque")
local Efeito = remotes:WaitForChild("Efeito")

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local efeitos = Instance.new("Folder")
efeitos.Name = "DaRocaEfeitos"
efeitos.Parent = workspace

local function cubo(tamanho, pos, cor, neon)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Size = tamanho
	p.Position = pos
	p.Color = cor
	p.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
	p.Parent = efeitos
	return p
end
local function tween(obj, tempo, props, estilo)
	local tw = TweenService:Create(obj, TweenInfo.new(tempo, estilo or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

------------------------------------------------------------------------------------
-- Tela: título, dicas, avisos, faixa de chefe e barra de vida
------------------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "DaRocaHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = jogador:WaitForChild("PlayerGui")

local function texto(pai, t, tam, pos, cor, fonte)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = tam
	l.Position = pos
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.Text = t
	l.TextScaled = true
	l.Font = fonte or Enum.Font.Arcade
	l.TextColor3 = cor or Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0
	l.TextStrokeColor3 = rgb(30, 20, 20)
	l.Parent = pai
	return l
end

local titulo = texto(gui, "DA ROÇA ADVENTURE", UDim2.fromScale(0.8, 0.12), UDim2.fromScale(0.5, 0.3), rgb(255, 226, 120))
local sub = texto(gui, "protótipo no Roblox", UDim2.fromScale(0.5, 0.05), UDim2.fromScale(0.5, 0.39), rgb(255, 255, 255))
task.delay(4, function()
	tween(titulo, 1, { TextTransparency = 1, TextStrokeTransparency = 1 })
	tween(sub, 1, { TextTransparency = 1, TextStrokeTransparency = 1 })
end)
local toque = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local dica = texto(gui, toque and "Analógico: andar   Pular 2x no ar   SOCO: bater" or "A/D andar   Espaço pular (2x no ar)   F ou clique: soco", UDim2.new(0.6, 0, 0, 22), UDim2.new(0.5, 0, 1, -18), rgb(240, 240, 240), Enum.Font.GothamBold)
task.delay(14, function()
	tween(dica, 1.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
end)

local aviso = texto(gui, "", UDim2.fromScale(0.4, 0.05), UDim2.fromScale(0.5, 0.2), rgb(140, 255, 150))
aviso.TextTransparency = 1
aviso.TextStrokeTransparency = 1
local function mostrarAviso(t)
	aviso.Text = t
	aviso.TextTransparency = 0
	aviso.TextStrokeTransparency = 0
	task.delay(1.6, function()
		if aviso.Text == t then
			tween(aviso, 0.6, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

local faixa = Instance.new("Frame")
faixa.Size = UDim2.new(1.4, 0, 0.16, 0)
faixa.AnchorPoint = Vector2.new(0.5, 0.5)
faixa.Position = UDim2.fromScale(-0.8, 0.42)
faixa.Rotation = -4
faixa.BackgroundColor3 = rgb(20, 16, 30)
faixa.BorderSizePixel = 0
faixa.Parent = gui
local faixaNome = texto(faixa, "", UDim2.fromScale(0.5, 0.62), UDim2.fromScale(0.5, 0.4), rgb(255, 214, 90))
local faixaSub = texto(faixa, "", UDim2.fromScale(0.4, 0.26), UDim2.fromScale(0.5, 0.82), rgb(230, 230, 240), Enum.Font.GothamBold)
local function mostrarFaixa(nome, s)
	faixaNome.Text = nome
	faixaSub.Text = s
	faixa.Position = UDim2.fromScale(-0.8, 0.42)
	tween(faixa, 0.35, { Position = UDim2.fromScale(0.5, 0.42) }, Enum.EasingStyle.Back)
	task.delay(1.9, function()
		tween(faixa, 0.35, { Position = UDim2.fromScale(1.8, 0.42) })
	end)
end

local barra = Instance.new("Frame")
barra.Size = UDim2.new(0.5, 0, 0, 18)
barra.AnchorPoint = Vector2.new(0.5, 0)
barra.Position = UDim2.new(0.5, 0, 0, 52)
barra.BackgroundColor3 = rgb(20, 16, 24)
barra.BorderSizePixel = 0
barra.Visible = false
barra.Parent = gui
local barraVida = Instance.new("Frame")
barraVida.Size = UDim2.fromScale(1, 1)
barraVida.BackgroundColor3 = rgb(230, 70, 60)
barraVida.BorderSizePixel = 0
barraVida.Parent = barra
local barraNome = texto(barra, "IGOR", UDim2.new(0.3, 0, 0, 18), UDim2.new(0.15, 0, 0, -12), rgb(255, 230, 120))

------------------------------------------------------------------------------------
-- Personagem: pista travada, virar de lado, pulo duplo, poeira
------------------------------------------------------------------------------------
local hrp, hum
local direcao = 1
local puloDuplo = false
local ultimoPedido = 0
local noAr = false

local function poeira(pos, n, forca)
	for i = 1, n do
		local c = cubo(Vector3.new(0.5, 0.5, 0.5), pos + Vector3.new((math.random() - 0.5) * 1.5, 0.2, 0), rgb(214, 196, 160))
		c.Transparency = 0.2
		local lado = (i % 2 == 0) and 1 or -1
		tween(c, 0.5 + math.random() * 0.3, { Position = c.Position + Vector3.new(lado * (1 + math.random() * forca), 0.6 + math.random(), 0), Transparency = 1, Size = Vector3.new(1.1, 1.1, 1.1) })
		Debris:AddItem(c, 0.9)
	end
end

local function aoNascer(ch)
	hum = ch:WaitForChild("Humanoid")
	hrp = ch:WaitForChild("HumanoidRootPart")
	hum.AutoRotate = false
	puloDuplo = false
	hum.StateChanged:Connect(function(_, novo)
		if novo == Enum.HumanoidStateType.Landed then
			if noAr then
				poeira(hrp.Position - Vector3.new(0, 2.8, 0), 6, 2)
			end
			noAr = false
			puloDuplo = false
		elseif novo == Enum.HumanoidStateType.Jumping or novo == Enum.HumanoidStateType.Freefall then
			noAr = true
		end
	end)
end
if jogador.Character then
	task.spawn(aoNascer, jogador.Character)
end
jogador.CharacterAdded:Connect(aoNascer)

UserInputService.JumpRequest:Connect(function()
	local agora = os.clock()
	local novoToque = agora - ultimoPedido > 0.2 -- segurar o botão não conta como 2º pulo
	ultimoPedido = agora
	if not hum or not hrp or hum.Health <= 0 then
		return
	end
	if noAr and novoToque and not puloDuplo and hum.FloorMaterial == Enum.Material.Air then
		puloDuplo = true
		local v = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(v.X, 50, 0)
		-- anel de ar em pixels sob os pés
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			local c = cubo(Vector3.new(0.4, 0.4, 0.4), hrp.Position - Vector3.new(0, 2.6, 0), rgb(255, 255, 255), true)
			tween(c, 0.35, { Position = c.Position + Vector3.new(math.cos(a) * 2.2, math.sin(a) * 0.5, 0), Transparency = 1 })
			Debris:AddItem(c, 0.4)
		end
	end
end)

------------------------------------------------------------------------------------
-- Soco: braço vai à frente, rastro branco em arco e aviso ao servidor
------------------------------------------------------------------------------------
local ombrosOriginais = {}
local combo = 0
local ultimoSoco = 0

local function rastro(pos, dir, cor)
	for i = 0, 5 do
		local a = math.rad(-60 + i * 24)
		local p = pos + Vector3.new(dir * (1.6 + math.cos(a) * 2.4), math.sin(a) * 2.4 + 0.6, 0.4)
		local c = cubo(Vector3.new(0.5, 0.5, 0.3), p, cor or rgb(255, 250, 230), true)
		c.Transparency = 0.1 + i * 0.05
		tween(c, 0.18, { Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) })
		Debris:AddItem(c, 0.25)
	end
end

local function animarSoco(ch)
	combo = combo + 1
	local direito = combo % 2 == 1
	local motor = ch:FindFirstChild(direito and "RightShoulder" or "LeftShoulder", true)
	local r6 = false
	if not motor then
		local torso = ch:FindFirstChild("Torso")
		motor = torso and torso:FindFirstChild(direito and "Right Shoulder" or "Left Shoulder")
		r6 = true
	end
	if not motor or not motor:IsA("Motor6D") then
		return
	end
	if not ombrosOriginais[motor] then
		ombrosOriginais[motor] = motor.C0
	end
	local orig = ombrosOriginais[motor]
	local giro
	if r6 then
		giro = CFrame.Angles(0, 0, math.rad(direito and 90 or -90))
	else
		giro = CFrame.Angles(math.rad(95), 0, 0)
	end
	local ida = TweenService:Create(motor, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = orig * giro })
	ida:Play()
	ida.Completed:Connect(function()
		TweenService:Create(motor, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { C0 = orig }):Play()
	end)
end

local function socar(_, estado)
	if estado ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	local agora = os.clock()
	if not hrp or not hum or hum.Health <= 0 or agora - ultimoSoco < 0.27 then
		return Enum.ContextActionResult.Sink
	end
	ultimoSoco = agora
	animarSoco(hrp.Parent)
	rastro(hrp.Position, direcao)
	-- passinho à frente no soco, como no jogo original
	local v = hrp.AssemblyLinearVelocity
	hrp.AssemblyLinearVelocity = Vector3.new(v.X + direcao * 14, v.Y, 0)
	Ataque:FireServer(direcao)
	return Enum.ContextActionResult.Sink
end
ContextActionService:BindAction("DaRocaSoco", socar, true, Enum.KeyCode.F, Enum.KeyCode.J, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonX)
ContextActionService:SetTitle("DaRocaSoco", "SOCO")
ContextActionService:SetPosition("DaRocaSoco", UDim2.new(1, -190, 1, -150))

------------------------------------------------------------------------------------
-- Efeitos enviados pelo servidor
------------------------------------------------------------------------------------
local tremor = 0
local function faiscas(pos, dir, cor)
	for i = 1, 10 do
		local c = cubo(Vector3.new(0.45, 0.45, 0.45), pos, i % 3 == 0 and cor or rgb(255, 240, 180), true)
		local alvo = pos + Vector3.new(dir * math.random() * 4 + (math.random() - 0.5) * 2, (math.random() - 0.3) * 3.5, 0.6)
		tween(c, 0.25 + math.random() * 0.15, { Position = alvo, Transparency = 1, Size = Vector3.new(0.15, 0.15, 0.15) })
		Debris:AddItem(c, 0.5)
	end
	local flash = cubo(Vector3.new(2.2, 2.2, 0.2), pos + Vector3.new(0, 0, 0.8), rgb(255, 255, 255), true)
	flash.CFrame = flash.CFrame * CFrame.Angles(0, 0, math.rad(45))
	tween(flash, 0.12, { Transparency = 1, Size = Vector3.new(3.4, 3.4, 0.2) })
	Debris:AddItem(flash, 0.2)
end

-- Onda de choque do Igor: blocos do chão saltam em sequência para os dois lados
local function ondaDeChoque(pos, forte)
	tremor = math.max(tremor, forte and 1.6 or 1.2)
	poeira(pos, 14, 5)
	local cores = { rgb(176, 170, 160), rgb(150, 144, 136), rgb(200, 192, 180) }
	for lado = -1, 1, 2 do
		for i = 1, 11 do
			task.delay(i * 0.035, function()
				local x = pos.X + lado * i * 1.3
				local c = cubo(Vector3.new(1.2, 1.2, 1.4), Vector3.new(x, -0.4, 0), cores[(i % 3) + 1])
				local sobe = TweenService:Create(c, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = Vector3.new(x, 1 + (11 - i) * 0.12, 0), Orientation = Vector3.new(0, 0, lado * -20) })
				sobe:Play()
				sobe.Completed:Connect(function()
					tween(c, 0.25, { Position = Vector3.new(x, -0.8, 0), Transparency = 1 }, Enum.EasingStyle.Quad)
				end)
				Debris:AddItem(c, 0.6)
				if i % 3 == 0 then
					local lasca = cubo(Vector3.new(0.4, 0.4, 0.4), Vector3.new(x, 0.6, 0.5), rgb(120, 110, 100))
					tween(lasca, 0.5, { Position = Vector3.new(x + lado * 1.5, 3 + math.random() * 2, 0.5), Transparency = 1 })
					Debris:AddItem(lasca, 0.6)
				end
			end)
		end
	end
	-- rachaduras no chão
	for i = -3, 3 do
		local r = cubo(Vector3.new(1.2, 0.08, 0.25), Vector3.new(pos.X + i * 1.1, 0.03, 0.4 + (i % 2) * 0.3), rgb(40, 34, 30))
		r.Orientation = Vector3.new(0, (i % 2 == 0) and 25 or -25, 0)
		task.delay(1.6, function()
			tween(r, 0.8, { Transparency = 1 })
		end)
		Debris:AddItem(r, 2.6)
	end
end

local function confete()
	local cores = { rgb(255, 80, 80), rgb(80, 180, 255), rgb(255, 220, 60), rgb(90, 220, 120), rgb(240, 120, 240) }
	if not hrp then
		return
	end
	for i = 1, 60 do
		local p = hrp.Position + Vector3.new((math.random() - 0.5) * 40, 18 + math.random() * 8, (math.random() - 0.5) * 4)
		local c = cubo(Vector3.new(0.5, 0.5, 0.1), p, cores[(i % #cores) + 1], true)
		tween(c, 2.5 + math.random(), { Position = p - Vector3.new(0, 22, 0), Orientation = Vector3.new(math.random(0, 360), math.random(0, 360), 0), Transparency = 0.5 }, Enum.EasingStyle.Linear)
		Debris:AddItem(c, 3.6)
	end
end

Efeito.OnClientEvent:Connect(function(tipo, a, b, c)
	if tipo == "golpe" then
		if a ~= jogador.UserId then
			rastro(b, c)
		end
	elseif tipo == "acerto" then
		faiscas(a, b, c)
		tremor = math.max(tremor, 0.35)
	elseif tipo == "impacto" then
		ondaDeChoque(a, b)
	elseif tipo == "empurrao" then
		if hrp then
			hrp.AssemblyLinearVelocity = Vector3.new(a, b, 0)
			tremor = math.max(tremor, 0.6)
		end
	elseif tipo == "banner" then
		mostrarFaixa(a, b)
	elseif tipo == "aviso" then
		mostrarAviso(a)
	elseif tipo == "vitoria" then
		mostrarFaixa("VITÓRIA!", "o Igor foi derrotado")
		confete()
	end
end)

------------------------------------------------------------------------------------
-- Cenário vivo: aves que fogem, torcida pulando, folhas no vento, balsa
------------------------------------------------------------------------------------
local aves = {}
local function registrarAve(m)
	if m:IsA("Model") and m.PrimaryPart then
		local origem = m:GetPivot()
		local partes = {}
		for _, p in ipairs(m:GetChildren()) do
			if p:IsA("BasePart") then
				partes[p] = origem:ToObjectSpace(p.CFrame)
			end
		end
		aves[m] = { origem = origem, partes = partes, estado = "chao", t = math.random() * 3, vx = 0 }
	end
end
for _, m in ipairs(CollectionService:GetTagged("Ave")) do
	registrarAve(m)
end
CollectionService:GetInstanceAddedSignal("Ave"):Connect(registrarAve)

local balanco = {}
local function registrarBalanco(p, forca, fase)
	if p:IsA("BasePart") then
		balanco[p] = { cf = p.CFrame, forca = forca, fase = fase or (p.Position.X * 0.15) }
	end
end
for _, p in ipairs(CollectionService:GetTagged("Copa")) do
	registrarBalanco(p, 1)
end
CollectionService:GetInstanceAddedSignal("Copa"):Connect(function(p)
	registrarBalanco(p, 1)
end)
local torcida = {}
local function registrarTorcida(p)
	if p:IsA("BasePart") then
		torcida[p] = { cf = p.CFrame, fase = math.random() * 6 }
	end
end
for _, p in ipairs(CollectionService:GetTagged("Torcida")) do
	registrarTorcida(p)
end
CollectionService:GetInstanceAddedSignal("Torcida"):Connect(registrarTorcida)

-- Coloca cada peça da ave a partir da posição original (as asas batem sem acumular giro)
local function moverAve(a, cf, bater)
	for p, rel in pairs(a.partes) do
		if p.Name == "Asa" and bater then
			p.CFrame = cf * rel * CFrame.Angles(bater, 0, 0)
		else
			p.CFrame = cf * rel
		end
	end
end

local function atualizarAves(dt, t)
	for m, a in pairs(aves) do
		if m.Parent then
			a.t = a.t + dt
			local origem = a.origem.Position
			if a.estado == "chao" then
				-- bicando o chão de vez em quando
				local bica = math.max(0, math.sin(a.t * 3)) ^ 6 * 0.25
				moverAve(a, a.origem * CFrame.new(0, -bica, 0))
				if hrp and math.abs(hrp.Position.X - origem.X) < 9 and math.abs(hrp.Position.Y - origem.Y) < 8 then
					a.estado = "voando"
					a.t = 0
					a.vx = (origem.X >= hrp.Position.X) and 1 or -1
				end
			elseif a.estado == "voando" then
				-- foge assustada: arranca para longe, subindo e batendo as asas
				local x = origem.X + a.vx * (a.t * 14 + a.t * a.t * 4)
				local y = origem.Y + a.t * 9 + a.t * a.t * 3
				local cf = CFrame.new(x, y, origem.Z - a.t * 4) * CFrame.Angles(0, a.vx > 0 and 0 or math.pi, math.rad(20))
				moverAve(a, cf, math.sin(t * 40) * 0.9)
				if a.t > 3 then
					a.estado = "longe"
					a.t = 0
					moverAve(a, a.origem + Vector3.new(0, -50, 0))
				end
			elseif a.estado == "longe" then
				if a.t > 12 and (not hrp or math.abs(hrp.Position.X - origem.X) > 30) then
					a.estado = "chao"
					a.t = 0
				end
			end
		else
			aves[m] = nil
		end
	end
end

local function atualizarCenario(t)
	local vento = math.sin(t * 0.6) * 0.5 + 0.5
	for p, b in pairs(balanco) do
		if p.Parent then
			local a = (math.sin(t * 2.2 + b.fase) * 0.04 + math.sin(t * 5.1 + b.fase * 2) * 0.012) * (0.6 + vento) * b.forca
			p.CFrame = b.cf * CFrame.new(math.sin(t * 2.2 + b.fase) * 0.12 * vento, 0, 0) * CFrame.Angles(0, 0, a)
		end
	end
	for p, b in pairs(torcida) do
		if p.Parent then
			local pulo = math.max(0, math.sin(t * 7 + b.fase)) * 0.5
			p.CFrame = b.cf + Vector3.new(0, pulo, 0)
		end
	end
end

-- Balsa: movida em todos os clientes pelo relógio do servidor, empurrando quem está em cima
RunService.Stepped:Connect(function()
	local t = workspace:GetServerTimeNow()
	for _, p in ipairs(CollectionService:GetTagged("Plataforma")) do
		local cx, amp, vel, y = p:GetAttribute("CentroX"), p:GetAttribute("Amp"), p:GetAttribute("Vel"), p:GetAttribute("Y")
		if cx then
			p.CFrame = CFrame.new(cx + math.sin(t * vel) * amp, y, 0)
			p.AssemblyLinearVelocity = Vector3.new(math.cos(t * vel) * amp * vel, 0, 0)
		end
	end
end)

------------------------------------------------------------------------------------
-- Câmera lateral e trava da pista
------------------------------------------------------------------------------------
local camX, camY, camDist = 0, 6, 40
local relogio = 0
local cenaAcc = 0
local inimigos = workspace:WaitForChild("DaRocaInimigos", 30)

RunService:BindToRenderStep("DaRocaCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	relogio = relogio + dt
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 50
	if hrp and hrp.Parent and hum then
		local p = hrp.Position
		-- virar para o lado em que anda (sem girar a câmera)
		local mx = hum.MoveDirection.X
		if math.abs(mx) > 0.15 then
			direcao = mx > 0 and 1 or -1
		end
		local giro = direcao > 0 and -math.pi / 2 or math.pi / 2
		local atual = hrp.CFrame
		local alvoCf = CFrame.new(p.X, p.Y, 0) * CFrame.Angles(0, giro, 0)
		hrp.CFrame = atual:Lerp(alvoCf, math.min(1, dt * 18))
		local v = hrp.AssemblyLinearVelocity
		if v.Z ~= 0 then
			hrp.AssemblyLinearVelocity = Vector3.new(v.X, v.Y, 0)
		end
		local a = 1 - math.exp(-dt * 5)
		camX = camX + (p.X + direcao * 5 - camX) * a
		camY = camY + (math.max(p.Y, 3) + 3 - camY) * a
		local naArena = p.X > 728
		camDist = camDist + ((naArena and 54 or 40) - camDist) * a
		if naArena then
			camX = camX + (math.clamp(p.X, 790, 830) - camX) * a * 0.5
		end
	end
	tremor = math.max(0, tremor - dt * 3)
	local s = tremor * tremor
	local off = Vector3.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, 0)
	camera.CFrame = CFrame.new(Vector3.new(camX, camY + 4, camDist) + off, Vector3.new(camX, camY + 1, 0) + off)

	atualizarAves(dt, relogio)
	cenaAcc = cenaAcc + dt
	if cenaAcc > 1 / 30 then -- folhas e torcida a 30 quadros bastam
		cenaAcc = 0
		atualizarCenario(relogio)
	end

	-- barra de vida do Igor
	local igor = inimigos and inimigos:FindFirstChild("Igor")
	if igor and igor:GetAttribute("Ativo") and hrp and hrp.Position.X > 720 then
		barra.Visible = true
		local hp, mx = igor:GetAttribute("HP") or 0, igor:GetAttribute("MaxHP") or 1
		barraVida.Size = UDim2.fromScale(math.clamp(hp / mx, 0, 1), 1)
		barraNome.Text = hp <= mx / 2 and "IGOR  (FURIOSO)" or "IGOR"
	else
		barra.Visible = false
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>
